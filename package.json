{
  "name": "audio-extract",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side video-to-audio extraction frontend. Demuxes the audio track from a video file entirely in the browser (no video decode) and hands the resulting audio file to a backend-issued upload URL.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mediabunny": "^1.56.2",
    "mp4box": "^1.3.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
